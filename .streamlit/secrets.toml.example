# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and fill in your real values.
# NEVER commit secrets.toml to git.

# Mistral API Key — get yours at https://console.mistral.ai/
API_KEY = "your_mistral_api_key_here"

# Optional overrides (defaults work fine for Streamlit Cloud)
# MODEL_NAME = "mistral-small-latest"
# MODEL_PROVIDER = "mistral"
# API_BASE_URL = "https://api.mistral.ai/v1"
