# Open-weight Model Configuration (<=16B parameters)
MODEL_NAME=llama-3.1-8b-instruct
MODEL_PROVIDER=mock  # Options: mock, ollama, hosted_openai, huggingface
API_KEY=your_api_key_here
API_BASE_URL=https://api.together.xyz/v1  # or local endpoint e.g. http://localhost:11434/v1

# Pipeline Hyperparameters
TOP_K_RETRIEVAL=30
SCORING_BATCH_SIZE=10
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
